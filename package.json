{
  "name": "greatscope-website",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./css/tailwind.css --minify",
    "minify:js": "terser js/script.js -c -m -o js/script.min.js",
    "build": "npm run build:css && npm run minify:js",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "terser": "^5.49.2"
  }
}
